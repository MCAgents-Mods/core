{
  "schemaVersion": 1,
  "id": "mcagents_core",
  "version": "${version}",
  "name": "MCAgents Core",
  "description": "The shared foundation MCAgents mods build on: the language model client, the in-game holograms other mods open, and the agent layer: the tool registry mods add tools to, the agent that calls them, and the menu G shows.",
  "authors": [
    "MCAgents"
  ],
  "contact": {
    "homepage": "https://github.com/MCAgents-Mods/core",
    "sources": "https://github.com/MCAgents-Mods/core",
    "issues": "https://github.com/MCAgents-Mods/core/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.mcagentsmods.core.fabric.CoreFabricMod"
    ],
    "client": [
      "io.github.mcagentsmods.core.fabric.CoreFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabricLoader}",
    "minecraft": "~${minecraft}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "breaks": {
    "mcagents": "<0.4.0",
    "mcagents_agents": "*"
  }
}
